def table_exists(schema, table):
    try:
        spark.table(f"{schema}.{table}")
        return True
    except AnalysisException:
        return False


def get_row_count(schema, table):
    return spark.table(f"{schema}.{table}").count()


def validate_ingestion_date(df, bronze_tbl):
    """Ensure INGESTION_DATE exists and is not null."""
    if "INGESTION_DATE" not in df.columns:
        raise ValueError(f"❌ INGESTION_DATE column missing in {bronze_tbl}")
    null_count = df.filter(F.col("INGESTION_DATE").isNull()).count()
    if null_count > 0:
        raise ValueError(f"❌ {null_count} NULL INGESTION_DATE rows in {bronze_tbl}")


def write_src_overwrite(bronze_tbl, src_tbl):
    """
    SRC layer — full overwrite every run.
    Always reflects latest bronze snapshot.
    No partitioning needed — this is current state only.
    """
    df = (spark.table(f"{BRONZE_SCHEMA}.{bronze_tbl}")
               .withColumn("SILVER_LOAD_TS", F.current_timestamp()))

    validate_ingestion_date(df, bronze_tbl)

    (df.write
       .format("delta")
       .mode("overwrite")
       .option("overwriteSchema", "true")
       .saveAsTable(f"{SILVER_SCHEMA}.{src_tbl}"))

    count = get_row_count(SILVER_SCHEMA, src_tbl)
    print(f"    ✓ SRC  → {SILVER_SCHEMA}.{src_tbl:<48} {count:>10,} rows  [OVERWRITE]")
    return count


def write_hist_partition(bronze_tbl, hist_tbl):
    """
    HIST layer — partitioned by INGESTION_DATE.
    - First run   : creates table with partitions
    - Re-run      : overwrites only that date's partition (idempotent)
    - New date    : adds new partition automatically
    
    INGESTION_DATE stays as a normal column AND is the partition key.
    No new column is added.
    """
    df = (spark.table(f"{BRONZE_SCHEMA}.{bronze_tbl}")
               .withColumn("SILVER_LOAD_TS", F.current_timestamp()))

    validate_ingestion_date(df, bronze_tbl)

    # Get the date(s) being loaded for logging
    dates_in_batch = [r[0] for r in df.select("INGESTION_DATE").distinct().collect()]

    (df.write
       .format("delta")
       .mode("overwrite")
       .partitionBy("INGESTION_DATE")
       .option("partitionOverwriteMode", "dynamic")  # only touch partitions in this batch
       .option("mergeSchema", "true")                # handle schema evolution safely
       .saveAsTable(f"{SILVER_SCHEMA}.{hist_tbl}"))

    count = get_row_count(SILVER_SCHEMA, hist_tbl)
    print(f"    ✓ HIST → {SILVER_SCHEMA}.{hist_tbl:<48} {count:>10,} rows  [PARTITION: {dates_in_batch}]")
    return count

def write_hist_partition(bronze_tbl, hist_tbl):
    df = (spark.table(f"{BRONZE_SCHEMA}.{bronze_tbl}")
               .withColumn("SILVER_LOAD_TS", F.current_timestamp())
               # ── Cast timestamp → date for clean partitioning ──
               .withColumn("INGESTION_DATE", F.to_date(F.col("INGESTION_DATE"))))

    validate_ingestion_date(df, bronze_tbl)

    dates_in_batch = [r[0] for r in df.select("INGESTION_DATE").distinct().collect()]

    (df.write
       .format("delta")
       .mode("overwrite")
       .partitionBy("INGESTION_DATE")
       .option("partitionOverwriteMode", "dynamic")
       .option("mergeSchema", "true")
       .saveAsTable(f"{SILVER_SCHEMA}.{hist_tbl}"))

    count = get_row_count(SILVER_SCHEMA, hist_tbl)
    print(f"    ✓ HIST → {SILVER_SCHEMA}.{hist_tbl:<48} {count:>10,} rows  [PARTITION: {dates_in_batch}]")
    return count

